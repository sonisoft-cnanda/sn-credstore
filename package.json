{
  "name": "@sonisoft/sn-credstore",
  "version": "1.0.1",
  "description": "Headless-safe credential storage for the ServiceNow SDK. Replaces the OS-keyring backend so non-interactive agents can authenticate.",
  "author": "Chris Nanda",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./register": {
      "types": "./dist/esm/register.d.ts",
      "import": "./dist/esm/register.js"
    },
    "./preload": {
      "require": "./preload.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "bin": {
    "sn-credstore": "./bin/sn-credstore.js",
    "now-sdk-x": "./bin/now-sdk-wrapped.cjs"
  },
  "files": [
    "dist",
    "bin",
    "preload.cjs",
    "README.md",
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo tsconfig.cjs.tsbuildinfo",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/stamp-cjs.mjs",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest --forceExit --coverage --ci",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "keywords": [
    "servicenow",
    "now-sdk",
    "credentials",
    "keyring",
    "headless",
    "oauth",
    "systemd-creds",
    "ci",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonisoft-cnanda/sn-credstore.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "jest": "^30.2.0",
    "rimraf": "^6.0.1",
    "semantic-release": "^25.0.8",
    "ts-jest": "^29.4.6",
    "typescript": "^5.5.4"
  },
  "homepage": "https://github.com/sonisoft-cnanda/sn-credstore#readme",
  "bugs": {
    "url": "https://github.com/sonisoft-cnanda/sn-credstore/issues"
  }
}
