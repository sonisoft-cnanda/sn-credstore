{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // NodeNext (not Bundler) because the ESM output must be runnable by Node
    // directly: that requires explicit .js extensions on relative imports, which
    // Bundler resolution would let us omit and then emit unrunnable output.
    // The CJS build overrides these and happily resolves the same .js specifiers.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist/esm",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
